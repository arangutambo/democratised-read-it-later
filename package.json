{
	"name": "obsidian-reader",
	"version": "0.1.0",
	"description": "Read-it-later, reader mode, highlighting and research capture for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"install-local": "node esbuild.config.mjs production && node scripts/install-local.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"books:dry-run": "esbuild tools/books-dry-run.ts --bundle --platform=node --format=cjs --outfile=.dry-run.cjs --log-level=error && node .dry-run.cjs",
		"anchor:bench": "esbuild tools/anchor-bench.ts --bundle --platform=node --format=cjs --outfile=.bench.cjs --log-level=error && node .bench.cjs",
		"slides:dry-run": "esbuild tools/slides-dry-run.ts --bundle --platform=node --format=cjs --outfile=.slides.cjs --log-level=error && node .slides.cjs",
		"zotero:dry-run": "esbuild tools/zotero-dry-run.ts --bundle --platform=node --format=cjs --outfile=.zot.cjs --log-level=error && node .zot.cjs",
		"pdf:dry-run": "esbuild tools/pdf-dry-run.ts --bundle --platform=node --format=cjs --outfile=.pdf.cjs --log-level=error && node .pdf.cjs"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.12.7",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.25.12",
		"obsidian": "^1.5.7",
		"pdfjs-dist": "^6.2.108",
		"typescript": "^5.4.5",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"@types/diff-match-patch": "^1.0.36",
		"@types/nunjucks": "^3.2.6",
		"diff-match-patch": "^1.0.5",
		"nunjucks": "^3.2.4"
	}
}
